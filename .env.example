# Token dat ook in de iPhone-app staat. Genereer met: openssl rand -hex 32
DAYLOG_API_TOKEN=change-me

# Hugging Face read-token, na het accepteren van de pyannote-voorwaarden
HF_TOKEN=

# Voor titels en samenvattingen (zonder key: alleen transcripts, geen samenvattingen)
ANTHROPIC_API_KEY=


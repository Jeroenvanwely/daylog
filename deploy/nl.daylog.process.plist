<?xml version="1.0" encoding="UTF-8"?>
<!-- Draait elke avond om 23:30 de batch. Staat de Mac dan in slaap, dan draait launchd
     hem bij het wakker worden alsnog. Installeren zoals nl.daylog.serve.plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>nl.daylog.process</string>
  <key>WorkingDirectory</key><string>/Users/YOU/code/daylog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>daylog</string><string>process</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/daylog-process.log</string>
  <key>StandardErrorPath</key><string>/tmp/daylog-process.log</string>
</dict>
</plist>
